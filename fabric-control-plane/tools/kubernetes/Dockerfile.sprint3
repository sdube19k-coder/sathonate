# Reuse the qualified protected CLI/controller tools; replace only the worker.
# The build receipt records and verifies the local base image ID.
ARG WORKER_BASE_IMAGE=sathonate/fabric-worker:sprint2
FROM ${WORKER_BASE_IMAGE}
USER root
COPY bin/fabric-worker-sprint3 /usr/local/bin/fabric-worker
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/fabric-worker"]
