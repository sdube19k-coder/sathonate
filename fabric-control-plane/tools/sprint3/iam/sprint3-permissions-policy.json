{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAccountAttributes",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumeStatus",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeRouteTables",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeAddresses",
        "ec2:DescribeNatGateways",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeTags",
        "eks:ListClusters",
        "eks:DescribeAddonVersions",
        "eks:DescribeAddonConfiguration",
        "eks:DescribeClusterVersions",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTags",
        "autoscaling:DescribeAutoScalingGroups"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "servicequotas:GetServiceQuota",
      "Resource": "arn:aws:servicequotas:ap-south-1:429488690613:ec2/L-1216C47A",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "freetier:GetAccountPlanState",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:ValidateTemplate",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack"
      ],
      "Resource": "arn:aws:cloudformation:ap-south-1:429488690613:stack/sathonate-s3-20261027/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:RequestTag/SathonateRun": "sathonate-s3-20261027"
        },
        "Null": {
          "cloudformation:RoleArn": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:DeleteStack",
        "cloudformation:CancelUpdateStack",
        "cloudformation:ContinueUpdateRollback"
      ],
      "Resource": "arn:aws:cloudformation:ap-south-1:429488690613:stack/sathonate-s3-20261027/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": [
        "arn:aws:iam::429488690613:role/sathonate-s3-20261027-clusterrole",
        "arn:aws:iam::429488690613:role/sathonate-s3-20261027-noderole",
        "arn:aws:iam::429488690613:role/sathonate-s3-20261027-cnirole",
        "arn:aws:iam::429488690613:role/sathonate-s3-20261027-ebsrole"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::429488690613:role/sathonate-s3-20261027-clusterrole",
        "arn:aws:iam::429488690613:role/sathonate-s3-20261027-cnirole",
        "arn:aws:iam::429488690613:role/sathonate-s3-20261027-ebsrole"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "eks.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::429488690613:role/sathonate-s3-20261027-noderole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "eks.amazonaws.com",
            "ec2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "eks:CreateCluster",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:RequestTag/SathonateRun": "sathonate-s3-20261027",
          "eks:kubernetesVersion": "1.34",
          "eks:authenticationMode": "API",
          "eks:supportType": "STANDARD"
        },
        "Bool": {
          "eks:bootstrapClusterCreatorAdminPermissions": "false",
          "eks:bootstrapSelfManagedAddons": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:DeleteCluster",
        "eks:ListNodegroups",
        "eks:ListAddons",
        "eks:ListAccessEntries",
        "eks:ListUpdates",
        "eks:DescribeUpdate",
        "eks:ListTagsForResource",
        "eks:DescribeNodegroup",
        "eks:DeleteNodegroup",
        "eks:DescribeAddon",
        "eks:DeleteAddon"
      ],
      "Resource": [
        "arn:aws:eks:ap-south-1:429488690613:cluster/sathonate-s3-20261027",
        "arn:aws:eks:ap-south-1:429488690613:nodegroup/sathonate-s3-20261027/zone-?/*",
        "arn:aws:eks:ap-south-1:429488690613:addon/sathonate-s3-20261027/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "eks:CreateNodegroup",
        "eks:CreateAddon"
      ],
      "Resource": "arn:aws:eks:ap-south-1:429488690613:cluster/sathonate-s3-20261027",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:RequestTag/SathonateRun": "sathonate-s3-20261027"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "eks:CreateAccessEntry",
      "Resource": "arn:aws:eks:ap-south-1:429488690613:cluster/sathonate-s3-20261027",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "eks:accessEntryType": "STANDARD",
          "aws:RequestTag/SathonateRun": "sathonate-s3-20261027"
        },
        "ArnLike": {
          "eks:principalArn": [
            "arn:aws:iam::429488690613:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_Sprint3-permissions_*",
            "arn:aws:iam::429488690613:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_Sprint3-permissions_*"
          ]
        },
        "Null": {
          "eks:kubernetesGroups": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "eks:DescribeAccessEntry",
        "eks:DeleteAccessEntry",
        "eks:ListAssociatedAccessPolicies",
        "eks:DisassociateAccessPolicy"
      ],
      "Resource": [
        "arn:aws:eks:ap-south-1:429488690613:access-entry/sathonate-s3-20261027/role/429488690613/AWSReservedSSO_Sprint3-permissions_*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "eks:AssociateAccessPolicy",
      "Resource": [
        "arn:aws:eks:ap-south-1:429488690613:access-entry/sathonate-s3-20261027/role/429488690613/AWSReservedSSO_Sprint3-permissions_*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "eks:policyArn": "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy",
          "eks:accessScope": "cluster"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "eks:TagResource",
      "Resource": [
        "arn:aws:eks:ap-south-1:429488690613:cluster/sathonate-s3-20261027",
        "arn:aws:eks:ap-south-1:429488690613:access-entry/sathonate-s3-20261027/role/429488690613/AWSReservedSSO_Sprint3-permissions_*/*",
        "arn:aws:eks:ap-south-1:429488690613:nodegroup/sathonate-s3-20261027/zone-?/*",
        "arn:aws:eks:ap-south-1:429488690613:addon/sathonate-s3-20261027/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/SathonateRun": "sathonate-s3-20261027"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable"
      ],
      "Resource": "arn:aws:ec2:ap-south-1:429488690613:vpc/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/SathonateRun": "sathonate-s3-20261027"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-south-1:429488690613:vpc/*",
        "arn:aws:ec2:ap-south-1:429488690613:subnet/*",
        "arn:aws:ec2:ap-south-1:429488690613:route-table/*",
        "arn:aws:ec2:ap-south-1:429488690613:internet-gateway/*",
        "arn:aws:ec2:ap-south-1:429488690613:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/SathonateRun": "sathonate-s3-20261027",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateRouteTable",
            "CreateInternetGateway",
            "CreateLaunchTemplate"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:ModifySubnetAttribute",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:DeleteVpc",
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteLaunchTemplate",
        "ec2:DescribeVpcAttribute"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:429488690613:vpc/*",
        "arn:aws:ec2:ap-south-1:429488690613:subnet/*",
        "arn:aws:ec2:ap-south-1:429488690613:route-table/*",
        "arn:aws:ec2:ap-south-1:429488690613:internet-gateway/*",
        "arn:aws:ec2:ap-south-1:429488690613:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/SathonateRun": "sathonate-s3-20261027"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteNetworkInterface",
        "ec2:DeleteSecurityGroup",
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:429488690613:volume/*",
        "arn:aws:ec2:ap-south-1:429488690613:network-interface/*",
        "arn:aws:ec2:ap-south-1:429488690613:security-group/*",
        "arn:aws:ec2:ap-south-1:429488690613:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/SathonateRun": "sathonate-s3-20261027"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:TagResource"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:429488690613:log-group:/aws/eks/sathonate-s3-20261027/cluster",
        "arn:aws:logs:ap-south-1:429488690613:log-group:/aws/eks/sathonate-s3-20261027/cluster:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/SathonateRun": "sathonate-s3-20261027"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:PutRetentionPolicy",
        "logs:DeleteLogGroup",
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:429488690613:log-group:/aws/eks/sathonate-s3-20261027/cluster",
        "arn:aws:logs:ap-south-1:429488690613:log-group:/aws/eks/sathonate-s3-20261027/cluster:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchDeleteImage",
        "ecr:DeleteRepository"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:429488690613:repository/sathonate-s3-20261027",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateInternetGateway",
        "ec2:CreateLaunchTemplate"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:429488690613:subnet/*",
        "arn:aws:ec2:ap-south-1:429488690613:route-table/*",
        "arn:aws:ec2:ap-south-1:429488690613:internet-gateway/*",
        "arn:aws:ec2:ap-south-1:429488690613:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/SathonateRun": "sathonate-s3-20261027"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateVpc",
      "Resource": "arn:aws:ec2:ap-south-1:429488690613:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/SathonateRun": "sathonate-s3-20261027"
        }
      }
    }
  ]
}
